{
  "name": "memento",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "pnpm --package=netlify-cli dlx netlify dev",
    "build": "pnpm typecheck && vite build",
    "build:android": "pnpm typecheck && vite build --mode native && cap sync android",
    "build:openui-prompt": "node --import ./scripts/component-hooks.mjs scripts/build-openui-prompt.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "node node_modules/typescript-7/bin/tsc -b",
    "format": "prettier --write src",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "node --experimental-strip-types --test \"scripts/test-*.mjs\"",
    "test:component": "node --test --import ./scripts/component-hooks.mjs \"scripts/test-*.tsx\"",
    "mock": "node scripts/mock-hermes.mjs",
    "e2e": "node scripts/e2e/cli.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@netlify/blobs": "^11.1.3",
    "@netlify/identity": "^2.0.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@netlify/functions": "^6.0.2",
    "@reticlehq/react": "3.9.0",
    "@reticlehq/vite-plugin": "3.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "typescript": "~6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
