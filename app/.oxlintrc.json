{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/lib/sidebar-layout.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*"
                ],
                "message": "sidebar-layout.ts holds no JSX and imports nothing: scripts/test-sidebar-layout.mjs loads it through Node's type stripping, which resolves no path alias. Pass what a row needs in as data instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
