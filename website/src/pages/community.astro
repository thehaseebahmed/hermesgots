---
import Board from "../components/Board.astro"
import Base from "../layouts/Base.astro"
---

<Base
  title="Gots Community"
  description="Who spends the most tokens and which models carry them, from people running Gots."
>
  <div class="shell board-page">
    <main>
      <span class="badge" id="sample-badge">Sample data</span>
      <div class="hero">
        <div>
          <h1>Community</h1>
          <p class="lede">Tokens used by people who chose to share their count.</p>
        </div>
      </div>
      <Board />
      <p class="note">
        Days run on UTC. Counts are reported by each person's Hermes host and only cover Gots.
      </p>
    </main>
  </div>
  <script>
    document.addEventListener("board:live", () => {
      document.getElementById("sample-badge")?.remove()
    })
  </script>
</Base>
