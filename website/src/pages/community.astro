---
import "../styles/board.css"
import Board from "../components/Board.astro"
import Base from "../layouts/Base.astro"
---

<Base
  title="Gots Community"
  description="Who spends the most tokens and which models carry them, from people running Gots."
>
  <div class="sky sky-page" aria-hidden="true"></div>
  <div class="shell board-page">
    <main>
      <span class="badge" id="sample-badge" hidden>Sample data</span>
      <div class="hero">
        <div>
          <p class="eyebrow">Leaderboard</p>
          <h1>Community</h1>
          <p class="lede">What people running Gots used this week. Join in Settings &gt; Community to add yours.</p>
        </div>
      </div>
      <Board />
      <p class="note">
        Days run on UTC. Counts are reported by each person's Hermes host and only cover Gots.
      </p>
    </main>
  </div>
</Base>
