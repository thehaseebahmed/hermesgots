---
import "../styles/home.css"
import Chat from "../components/Chat.astro"
import Dictation from "../components/Dictation.astro"
import Phone from "../components/Phone.astro"
import Base from "../layouts/Base.astro"

const stages = [
  {
    id: "code",
    word: "Code",
    tag: "Code",
    title: "Sessions that end in a pull request.",
    body: "Every session gets a worktree of its own and opens a draft pull request. Use plan mode to read the plan before anything is written. Leave AFK on and your host works through the issues you've labelled, runs your tests itself and never merges.",
    chips: ["Plan mode", "Worktrees", "AFK", "Skills"],
    shot: "code",
  },
  {
    id: "research",
    word: "Research",
    tag: "Research missions",
    title: "Answers with receipts.",
    body: "A mission reads the web, then writes a guide where every sentence points at its source. The host re-checks each quote and flags anything unsourced. Compare and decide scores your options against the criteria you set.",
    chips: ["Learn & understand", "Compare & decide", "Cited"],
    shot: "research",
  },
  {
    id: "dictate",
    word: "Dictate",
    tag: "Dictation",
    title: "Dictation that runs on your own bot.",
    body: "Talk into any chat. Your Hermes host transcribes it with the speech model you pick, tidies it to the level you want and drops the words where your cursor was. Teach it your names and jargon once.",
    chips: ["Your vocabulary", "Cleanup levels", "Your host"],
    dictate: true,
  },
  {
    id: "generate",
    word: "Generate",
    tag: "Generative UI",
    title: "Replies that are interfaces.",
    body: "Built on OpenUI. An answer can come back as a table, a chart, a form or buttons you use in place, so a decision is a tap instead of a paragraph.",
    chips: ["OpenUI", "Approvals in place", "Tables & charts"],
    shot: "approve",
  },
]

const coming = [
  {
    bot: "orbi",
    title: "Bot chatrooms",
    body: "Put several bots in one room and let them work a problem together.",
  },
  {
    bot: "penny",
    title: "Meeting transcription",
    body: "Hand over a recording. Get back what was decided, what's yours to do and a timeline to check it against.",
  },
  {
    bot: "bloom",
    title: "Apps from replies",
    body: "Ask for a small app. It lives beside your chats, drawn from the same OpenUI parts.",
  },
  {
    bot: "gem",
    title: "Calling",
    body: "Ring a bot and talk it through, or let it ring you when something is waiting on you.",
  },
]
---

<Base
  title="Gots: Hermes Bots that got your back"
  description="Gots is the app for your Hermes Agent, on your phone and your laptop. Code, research, dictation and generative UI, running on your own host."
>
  <main>
    <section class="home-hero">
      <div class="wrap hero-copy">
        <p class="tag" data-reveal>Hermes Bots that got your back</p>
        <h1 data-reveal style="--d:60ms">Ask. Close the app. Come back to it <em>done.</em></h1>
        <p class="lede" data-reveal style="--d:120ms">
          Gots is the app for your Hermes agent. It works on your own host, so the job keeps going when your phone sleeps, and you pick it up on whichever screen is closer.
        </p>
        <div class="cta" data-reveal style="--d:180ms">
          <a class="btn" href="#waitlist">Join the waiting list</a>
          <a class="btn btn-ghost" href="#features">See what it does</a>
        </div>
        <p class="where" data-reveal style="--d:240ms">Phone · Tablet · Laptop</p>
      </div>

      <figure class="hero-art" aria-label="The same coding session open on a laptop and on a phone">
        <div class="laptop">
          <div class="laptop-lid"><div class="laptop-screen"><Chat variant="laptop" /></div></div>
          <div class="laptop-base"></div>
        </div>
        <div class="hero-phone">
          <div class="phone"><div class="phone-screen"><Chat variant="phone" /></div></div>
        </div>
        <p class="hero-bubble"><img src="/bots/hex.png" alt="" width="48" height="48" />On it.</p>
      </figure>
    </section>

    <div id="features">
      {
        stages.map((s, i) => (
          <>
            <div class="wedge" aria-hidden="true"><span>{s.word}</span></div>
            <section class:list={["stage", { flip: i % 2 === 1 }]} aria-labelledby={`${s.id}-title`}>
              <div class="wrap stage-grid">
                <div class="stage-copy" data-reveal>
                  <span class="tag">{s.tag}</span>
                  <h2 id={`${s.id}-title`}>{s.title}</h2>
                  <p>{s.body}</p>
                  <ul class="chips">
                    {s.chips.map((chip) => <li>{chip}</li>)}
                  </ul>
                </div>
                <div class="stage-art" data-reveal style="--d:100ms">
                  {s.dictate ? (
                    <Dictation />
                  ) : (
                    <div class="phone art-phone">
                      <Phone shot={s.shot!} alt={s.title} />
                    </div>
                  )}
                </div>
              </div>
            </section>
          </>
        ))
      }
    </div>

    <section id="coming" class="coming">
      <div class="wrap">
        <span class="tag" data-reveal>Coming soon</span>
        <h2 class="section-title" data-reveal>Next in the room.</h2>
        <ul class="coming-grid">
          {
            coming.map((c, i) => (
              <li data-reveal style={`--d:${i * 70}ms`}>
                <img src={`/bots/${c.bot}.png`} alt="" width="96" height="96" loading="lazy" />
                <span class="soon">Coming soon</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="pricing" class="pricing">
      <div class="wrap">
        <span class="tag" data-reveal>Pricing</span>
        <h2 class="section-title" data-reveal>Two ways in. Both simple.</h2>

        <div class="plans">
          <article id="waitlist" class="plan plan-featured" data-reveal>
            <span class="tag">Hosted</span>
            <p class="price">Waiting list</p>
            <p class="plan-lede">
              Gots, run for you. Leave your email and you're first in when the doors open.
            </p>
            <form class="waitlist" name="waitlist" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" data-waitlist>
              <input type="hidden" name="form-name" value="waitlist" />
              <p class="sr-only"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
              <label class="sr-only" for="email">Email</label>
              <input id="email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
              <button class="btn" type="submit">Count me in</button>
              <p class="thanks" role="status">You're on the list. We'll be in touch.</p>
              <p class="form-error" role="alert">That didn't go through. Try again in a moment.</p>
            </form>
            <ul class="ticks">
              <li>One email when your spot opens</li>
              <li>First look at new features</li>
            </ul>
          </article>

          <article class="plan" data-reveal style="--d:100ms">
            <span class="tag">Self-host</span>
            <p class="price">Free</p>
            <p class="plan-lede">Run it on your own Hermes host. Your chats, runs and keys stay with you.</p>
            <ul class="ticks">
              <li>Every feature in the app</li>
              <li>Open source, MIT licensed</li>
              <li>End-to-end encrypted sync</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
  </main>

  <div class="dock" data-dock>
    <span class="wordmark">Gots</span>
    <a class="btn btn-sm" href="#waitlist">Join the waiting list</a>
  </div>
</Base>
