---
import Phone from "../components/Phone.astro"
import Base from "../layouts/Base.astro"

const slides = [
  {
    tag: "Chat",
    title: "Replies that are interfaces.",
    body: "An agent's answer doesn't have to be a wall of text. Gots can draw it as a real interface, with tables, forms and buttons you use in place, so a decision is a tap and a result is something you can work with. Run as many bots as you like, each keeping its threads in order.",
    chips: ["Multiple Bots", "Smart Threads", "Interactive Replies"],
    shot: "approve",
    bot: "gem",
    glow: "var(--usage-input)",
  },
  {
    tag: "Code",
    title: "Work that ends in a pull request.",
    body: "Every session gets a worktree of its own and opens a draft pull request. Leave AFK on and your host works through the issues you've labelled while you're away: it builds, runs your tests itself, and never merges.",
    chips: ["AFK Mode", "Output Library", "Skill Management"],
    shot: "code",
    bot: "hex",
    glow: "var(--usage-cache-read)",
  },
  {
    tag: "Research",
    title: "Answers with receipts.",
    body: "A mission reads the web and writes a guide where each sentence points to its source. The host re-checks every quote and flags anything unsourced, and you can have another model write it again to compare.",
    chips: ["Structured", "Multi Model Analysis"],
    shot: "research",
    bot: "stella",
    glow: "var(--usage-cache-write)",
  },
  {
    tag: "Meetings",
    title: "The meeting, without the minutes.",
    body: "Hand over a recording or a transcript and the bot returns what was decided and what's yours to do, with a timeline to check it against.",
    chips: ["Smart Summary", "Transcription", "Action Items", "Smart Hand-offs"],
    bot: "penny",
    glow: "var(--primary)",
  },
  {
    tag: "Routines",
    title: "Scheduled work that shows its work.",
    body: "Every routine across your bots, with its recent runs as little bars. When one starts failing it rises to the top, and your phone hears about it before you go looking.",
    chips: ["Run History", "Failure Alerts"],
    shot: "routines",
    bot: "tri",
    glow: "var(--usage-output)",
  },
  {
    tag: "Community",
    title: "See how you stack up.",
    body: "Find out which providers and models people are really using this week or this month, and where your own tokens put you. It's opt-in, and you can leave whenever you like.",
    chips: [],
    shot: "community",
    cta: { href: "/community", label: "See the leaderboard" },
    bot: "bloom",
    glow: "var(--merged)",
  },
  {
    tag: "Yours",
    title: "Your host. Your keys.",
    body: "Gots is a window onto a Hermes agent you run yourself. Your chats and keys stay with you, and settings sync end-to-end encrypted, so the server only ever holds ciphertext.",
    chips: [],
    shot: "bots",
    bot: "cubby",
    glow: "var(--usage-input)",
  },
]

const extras = [
  "Photos and files",
  "Share sheet",
  "Dictation on your host",
  "Per-chat model picker",
  "MCP servers",
  "Notifications by type",
  "Light and dark",
  "Eight bots",
  "Todo pills",
]

const coming = [
  {
    bot: "penny",
    status: "Next up",
    title: "Voice Call",
    body: "Ring a bot and talk it through, or let it ring you when something is waiting on you.",
  },
  {
    bot: "gem",
    status: "Wishlist",
    title: "Raycast Integration",
    body: "Ask your bots from the launcher, without opening an app.",
  },
  {
    bot: "bloom",
    status: "Wishlist",
    title: "Speech-to-Text anywhere",
    body: "Dictate into any app on your computer, transcribed by your own Hermes host.",
  },
  {
    bot: "cubby",
    status: "Wishlist",
    title: "Phone Integration",
    body: "Let your bots see your calendar, contacts and more, only when you allow it.",
  },
  {
    bot: "orbi",
    status: "Wishlist",
    title: "Bot-to-Bot Communication",
    body: "Your bots hand work to each other, even when they live on different hosts.",
  },
  {
    bot: "stella",
    status: "Next up",
    title: "More research missions",
    body: "Learn and understand is ready. Six more mission types are lining up behind it.",
  },
  {
    bot: "hex",
    status: "After the beta",
    title: "Google Play",
    body: "The Android app, straight from the store.",
  },
  {
    bot: "tri",
    status: "Wishlist",
    title: "An iOS app",
    body: "Share into Gots from the iPhone share sheet, like Android does.",
  },
]

const floaters = [
  { bot: "gem", style: "--x:-6%;--y:18%;--s:5.5rem;--r:-8deg;--k:60;--t:0s" },
  { bot: "bloom", style: "--x:92%;--y:8%;--s:6.5rem;--r:10deg;--k:-40;--t:-2s" },
  { bot: "orbi", style: "--x:8%;--y:62%;--s:4.5rem;--r:6deg;--k:-70;--t:-4s" },
  { bot: "stella", style: "--x:88%;--y:56%;--s:5rem;--r:-12deg;--k:50;--t:-1s" },
  { bot: "hex", style: "--x:22%;--y:-6%;--s:3.75rem;--r:14deg;--k:80;--t:-3s" },
]
---

<Base
  title="Gots: Hermes Bots that got your back"
  description="Gots gives you Hermes Bots that got your back. Code, research and more with your Hermes Agent from your phone, and come back to find it done."
>
  <main>
    <section class="lp-hero" data-hero>
      <div class="wrap hero-copy">
        <h1 class="mega" data-reveal="pop" style="--d:80ms">
          Hermes Bots that<br />got your <em>back!</em>
        </h1>
        <p class="lede-xl" data-reveal="rise" style="--d:180ms">
          Ask for something, close Gots, and come back to find it done. Your Hermes agent keeps working on your own host, and your phone gets a push when it needs you.
        </p>
        <div class="cta" data-reveal="rise" style="--d:280ms">
          <a class="btn" href="#features">See what it does</a>
          <a class="btn btn-ghost" href="#coming">What's cooking</a>
        </div>
      </div>

      <div class="hero-stage">
        {
          floaters.map((f) => (
            <img class="floater" src={`/bots/${f.bot}.png`} alt="" width="96" height="96" style={f.style} />
          ))
        }
        <div class="hero-phone">
          <div class="phone"><Phone shot="bots" eager alt="The list of Hermes Bots in Gots" /></div>
        </div>
      </div>
    </section>

    <section id="features" class="story" data-story data-count={slides.length} data-active="0" style={`--n:${slides.length}`}>
      <div class="story-sticky">
        <div class="wrap story-head">
          <span class="eyebrow">New</span>
        </div>
        <div class="wrap story-grid">
          <div class="story-copy">
            {
              slides.map((s, i) => (
                <article class="copy" data-i={i}>
                  <span class="tag">{s.tag}</span>
                  <h2>{s.title}</h2>
                  <p>{s.body}</p>
                  {s.chips.length > 0 && (
                    <ul class="chips">
                      {s.chips.map((chip) => <li>{chip}</li>)}
                    </ul>
                  )}
                  {s.cta && <a class="btn btn-ghost" href={s.cta.href}>{s.cta.label}</a>}
                </article>
              ))
            }
          </div>

          <div class="story-device">
            {
              slides.map((s, i) => (
                <span class="glow" data-i={i} style={`--glow:${s.glow}`} />
              ))
            }
            <div class="phone">
              {
                slides.map((s, i) => (
                  <div class="slide" data-i={i}>
                    {s.shot ? (
                      <Phone shot={s.shot} alt={s.title} />
                    ) : (
                      <div class="phone-fill soon-screen">
                        <img src={`/bots/${s.bot}.png`} alt="" width="96" height="96" />
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            {
              slides.map((s, i) => (
                <img
                  class="mascot"
                  data-i={i}
                  src={`/bots/${s.bot}.png`}
                  alt=""
                  width="96"
                  height="96"
                />
              ))
            }
          </div>
        </div>
        <ol class="dots" aria-label="Features">
          {
            slides.map((s, i) => (
              <li>
                <button type="button" data-dot={i} aria-label={s.tag} aria-current={i === 0}>
                  <span></span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="extras">
      <div class="wrap">
        <h2 class="section-title" data-reveal="rise">And a pocketful more.</h2>
        <ul class="pills">
          {
            extras.map((name, i) => (
              <li data-reveal="pop" style={`--d:${i * 60}ms`}>{name}</li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="coming" class="coming">
      <div class="wrap">
        <span class="eyebrow" data-reveal="pop">Coming soon</span>
        <h2 class="section-title" data-reveal="rise">What's cooking.</h2>
      </div>
      <ul class="deck" tabindex="0" aria-label="Coming soon">
        {
          coming.map((card, i) => (
            <li class="card" data-reveal="pop" style={`--d:${i * 80}ms;--tilt:${i % 2 ? 1.5 : -1.5}deg`}>
              <span class="sticker">{card.status}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <img src={`/bots/${card.bot}.png`} alt="" width="96" height="96" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="pricing" class="pricing">
      <div class="wrap">
        <span class="eyebrow" data-reveal="pop">Pricing</span>
        <h2 class="section-title" data-reveal="rise">Two ways in. Both simple.</h2>

        <div class="plans">
          <article id="waitlist" class="plan plan-featured" data-reveal="rise">
            <span class="tag">Hosted</span>
            <p class="price">Waiting list</p>
            <p class="plan-lede">
              Gots, run for you. Leave your email and you're first in when the doors open.
            </p>
            <form class="waitlist" name="waitlist" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" data-waitlist>
              <input type="hidden" name="form-name" value="waitlist" />
              <p class="sr-only"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
              <label class="sr-only" for="email">Email</label>
              <input id="email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
              <button class="btn" type="submit">Count me in</button>
              <p class="thanks" role="status">You're on the list. We'll be in touch.</p>
              <p class="form-error" role="alert">That didn't go through. Try again in a moment.</p>
            </form>
            <ul class="ticks">
              <li>One email when your spot opens</li>
              <li>First look at new features</li>
            </ul>
          </article>

          <article class="plan" data-reveal="rise" style="--d:120ms">
            <span class="tag">Self-host</span>
            <p class="price">Free</p>
            <p class="plan-lede">Run it on your own Hermes host. Your chats, runs and keys stay with you.</p>
            <ul class="ticks">
              <li>Every feature in the app</li>
              <li>Open source, MIT licensed</li>
              <li>End-to-end encrypted sync</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>
