---
import { KINDS, MODES, PERIODS, sampleBoard } from "../lib/board"
import { modelsList, tokensList } from "../lib/render"

const sample = sampleBoard()
const base = (import.meta.env.PUBLIC_COMMUNITY_URL ?? "").replace(/\/+$/, "")
const endpoint = base ? `${base}/.netlify/functions/community?route=board` : ""
// With a live board configured the page waits for it; the sample shows only when there is none.
const loading = '<li class="empty">Loading…</li>'
---

<div id="board" data-endpoint={endpoint}>
  <div class="tabs" role="tablist" aria-label="Period">
    {
      PERIODS.map((period, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${period.id}`}
          aria-controls={`panel-${period.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          data-period={period.id}
        >
          {period.label}
        </button>
      ))
    }
  </div>

  {
    PERIODS.map((period, index) => (
      <section
        class="panel"
        role="tabpanel"
        id={`panel-${period.id}`}
        aria-labelledby={`tab-${period.id}`}
        hidden={index !== 0}
      >
        <h2>Top tokens spent</h2>
        <ul class="legend" aria-label="Token types">
          {KINDS.map((kind) => <li><span class={`dot ${kind.key}`} />{kind.label}</li>)}
        </ul>
        <ol class="rows" data-list="tokens" set:html={endpoint ? loading : tokensList(sample.periods[period.id], { live: false })} />

        <h2>Top models</h2>
        <ul class="legend" aria-label="Modes">
          {MODES.map((mode) => <li><span class={`dot mode-${mode.key}`} />{mode.label}</li>)}
        </ul>
        <ol class="rows" data-list="models" set:html={endpoint ? loading : modelsList(sample.periods[period.id], { live: false })} />
      </section>
    ))
  }
</div>

<script>
  import { PERIODS, readBoard, sampleBoard } from "../lib/board"
  import { modelsList, tokensList } from "../lib/render"

  const root = document.getElementById("board")!
  const badge = document.getElementById("sample-badge")
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'))

  function select(period: string, focus = false) {
    for (const tab of tabs) {
      const on = tab.dataset.period === period
      tab.setAttribute("aria-selected", String(on))
      tab.tabIndex = on ? 0 : -1
      if (on && focus) tab.focus()
    }
    for (const panel of panels) panel.hidden = panel.id !== `panel-${period}`
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      select(tab.dataset.period!)
      history.replaceState(null, "", `#${tab.dataset.period}`)
    })
    tab.addEventListener("keydown", (event) => {
      const index = tabs.indexOf(tab)
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (!step) return
      event.preventDefault()
      const next = tabs[(index + step + tabs.length) % tabs.length]!
      select(next.dataset.period!, true)
    })
  }

  const wanted = location.hash.slice(1)
  select(tabs.some((tab) => tab.dataset.period === wanted) ? wanted : tabs[0]!.dataset.period!)

  function show(board: ReturnType<typeof sampleBoard>, live: boolean) {
    for (const { id } of PERIODS) {
      const panel = document.getElementById(`panel-${id}`)!
      panel.querySelector('[data-list="tokens"]')!.innerHTML = tokensList(board.periods[id], { live })
      panel.querySelector('[data-list="models"]')!.innerHTML = modelsList(board.periods[id], { live })
    }
    badge?.toggleAttribute("hidden", live)
  }

  // Only a board that can't be read falls back to the sample, and then says so.
  const endpoint = root.dataset.endpoint
  if (!endpoint) {
    show(sampleBoard(), false)
  } else {
    fetch(endpoint)
      .then((response) => (response.ok ? response.json() : null))
      .then((value) => {
        const board = readBoard(value)
        if (board) {
          show(board, true)
          document.dispatchEvent(new CustomEvent("board:live", { detail: board.updatedAt }))
        } else {
          show(sampleBoard(), false)
        }
      })
      .catch(() => show(sampleBoard(), false))
  }
</script>
