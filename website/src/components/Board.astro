---
import { MODES, sampleBoard, type PeriodId } from "../lib/board"
import { modelsList, providersList, tokensLegend, tokensList } from "../lib/render"

// The control's periods, each reading one of the board's own periods. Today is left out on purpose.
const PERIODS: { id: string; label: string; period: PeriodId }[] = [
  { id: "daily", label: "Daily", period: "today" },
  { id: "weekly", label: "Weekly", period: "week" },
  { id: "monthly", label: "Monthly", period: "month" },
]
const DEFAULT = "weekly"
const sample = sampleBoard().periods[PERIODS.find((p) => p.id === DEFAULT)!.period]
const base = (import.meta.env.PUBLIC_COMMUNITY_URL ?? "").replace(/\/+$/, "")
const endpoint = base ? `${base}/.netlify/functions/community?route=board` : ""
// With a live board configured the page waits for it; the sample shows only when there is none.
const loading = '<li class="empty">Loading…</li>'
---

<div id="board" data-endpoint={endpoint} data-default={DEFAULT}>
  <div class="switch" role="tablist" aria-label="Period">
    {
      PERIODS.map((item) => (
        <button
          type="button"
          role="tab"
          aria-selected={item.id === DEFAULT ? "true" : "false"}
          data-period={item.id}
          data-source={item.period}
        >
          {item.label}
        </button>
      ))
    }
  </div>

  <section class="panel">
    <section class="board" data-board="tokens">
      <h2>Top tokens spent</h2>
      <ul class="legend" aria-label="Models" data-list="legend" set:html={endpoint ? "" : tokensLegend(sample)} />
      <ol class="rows" data-list="tokens" set:html={endpoint ? loading : tokensList(sample, { live: false })} />
    </section>

    <section class="board" data-board="models">
      <h2>Top models</h2>
      <ul class="legend" aria-label="Modes">
        {MODES.map((mode) => <li><span class={`dot mode-${mode.key}`} />{mode.label}</li>)}
      </ul>
      <ol class="rows" data-list="models" set:html={endpoint ? loading : modelsList(sample, { live: false })} />
    </section>

    <section class="board" data-board="providers">
      <h2>Top providers</h2>
      <ol class="rows" data-list="providers" set:html={endpoint ? loading : providersList(sample, { live: false })} />
    </section>
  </section>
</div>

<script>
  import { readBoard, sampleBoard, type PeriodId } from "../lib/board"
  import { modelsList, providersList, tokensLegend, tokensList } from "../lib/render"

  // The period last picked on this device, so a return visit opens where the person left off.
  const STORED_PERIOD = "gots-community-period"
  const root = document.getElementById("board")!
  const badge = document.getElementById("sample-badge")
  const switches = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
  const known = (id: string | null) => switches.some((b) => b.dataset.period === id)
  const fallback = root.dataset.default!
  const boardFor = (id: string) =>
    switches.find((b) => b.dataset.period === id)!.dataset.source as PeriodId

  let current = sampleBoard()
  let live = false

  function remember(value: string) {
    try {
      localStorage.setItem(STORED_PERIOD, value)
    } catch {
      // Storage blocked: the page still works, it just won't remember.
    }
  }

  function stored() {
    try {
      return localStorage.getItem(STORED_PERIOD)
    } catch {
      return null
    }
  }

  function show(id: string) {
    const period = current.periods[boardFor(id)]
    for (const button of switches) {
      const on = button.dataset.period === id
      button.setAttribute("aria-selected", String(on))
      button.tabIndex = on ? 0 : -1
    }
    root.querySelector('[data-list="legend"]')!.innerHTML = tokensLegend(period)
    root.querySelector('[data-list="tokens"]')!.innerHTML = tokensList(period, { live })
    root.querySelector('[data-list="models"]')!.innerHTML = modelsList(period, { live })
    root.querySelector('[data-list="providers"]')!.innerHTML = providersList(period, { live })
    badge?.toggleAttribute("hidden", live)
  }

  function pick(id: string, focus = false) {
    const button = switches.find((b) => b.dataset.period === id)
    if (focus) button?.focus()
    remember(id)
    show(id)
  }

  for (const button of switches) {
    button.addEventListener("click", () => pick(button.dataset.period!))
    button.addEventListener("keydown", (event) => {
      const index = switches.indexOf(button)
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (!step) return
      event.preventDefault()
      const next = switches[(index + step + switches.length) % switches.length]!
      pick(next.dataset.period!, true)
    })
  }

  const initial = known(stored()) ? stored()! : fallback
  // Only a board that can't be read falls back to the sample, and then says so.
  const endpoint = root.dataset.endpoint
  if (!endpoint) {
    show(initial)
  } else {
    fetch(endpoint)
      .then((response) => (response.ok ? response.json() : null))
      .then((value) => {
        const board = readBoard(value)
        if (board) {
          current = board
          live = true
          document.dispatchEvent(new CustomEvent("board:live", { detail: board.updatedAt }))
        }
        show(initial)
      })
      .catch(() => show(initial))
  }
</script>
