---
import { BOT_NAMES, KINDS, PERIODS, formatTokens, shares, total, type Board } from "../lib/board"

interface Props {
  board: Board
  limit?: number
}

const { board, limit = 10 } = Astro.props
---

<div class="tabs" role="tablist" aria-label="Period">
  {
    PERIODS.map((period, index) => (
      <button
        type="button"
        role="tab"
        id={`tab-${period.id}`}
        aria-controls={`panel-${period.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        data-period={period.id}
      >
        {period.label}
      </button>
    ))
  }
</div>

<ul class="legend" aria-label="Token types">
  {KINDS.map((kind) => <li><span class={`dot ${kind.key}`} />{kind.label}</li>)}
</ul>

{
  PERIODS.map((period, index) => (
    <section
      class="panel"
      role="tabpanel"
      id={`panel-${period.id}`}
      aria-labelledby={`tab-${period.id}`}
      hidden={index !== 0}
    >
      <ol class="rows">
        {board[period.id].slice(0, limit).map((entry, rank) => {
          const part = shares(entry)
          return (
            <li class={rank === 0 ? "row first" : "row"}>
              <span class="rank">{rank + 1}</span>
              <img class="avatar" src={`/bots/${entry.bot}.png`} alt="" width="44" height="44" />
              <div class="who">
                <span class="handle">
                  <b>{entry.handle}</b>
                  <small>{BOT_NAMES[entry.bot]}</small>
                </span>
                <div
                  class="split"
                  role="img"
                  aria-label={part.map((kind) => `${Math.round(kind.percent)}% ${kind.label.toLowerCase()}`).join(", ")}
                >
                  {part.map((kind) => (
                    <span class={`seg ${kind.key}`} style={`width:${kind.percent}%`} />
                  ))}
                </div>
              </div>
              <div class="tokens">
                {formatTokens(total(entry))}
                <small>tokens</small>
              </div>
            </li>
          )
        })}
      </ol>
    </section>
  ))
}

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'))

  function select(period: string, focus = false) {
    for (const tab of tabs) {
      const on = tab.dataset.period === period
      tab.setAttribute("aria-selected", String(on))
      tab.tabIndex = on ? 0 : -1
      if (on && focus) tab.focus()
    }
    for (const panel of panels) panel.hidden = panel.id !== `panel-${period}`
  }

  for (const [index, tab] of tabs.entries()) {
    tab.addEventListener("click", () => {
      select(tab.dataset.period!)
      history.replaceState(null, "", `#${tab.dataset.period}`)
    })
    tab.addEventListener("keydown", (event) => {
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (!step) return
      event.preventDefault()
      const next = tabs[(index + step + tabs.length) % tabs.length]!
      select(next.dataset.period!, true)
    })
  }

  const wanted = location.hash.slice(1)
  select(tabs.some((tab) => tab.dataset.period === wanted) ? wanted : tabs[0]!.dataset.period!)
</script>
