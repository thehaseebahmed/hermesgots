---
import { MODES, sampleBoard } from "../lib/board"
import { modelsList, providersList, tokensLegend, tokensList } from "../lib/render"

// The board shows the week; the period tabs are gone until there is more to compare.
const PERIOD = "week"
const sample = sampleBoard().periods[PERIOD]
const base = (import.meta.env.PUBLIC_COMMUNITY_URL ?? "").replace(/\/+$/, "")
const endpoint = base ? `${base}/.netlify/functions/community?route=board` : ""
// With a live board configured the page waits for it; the sample shows only when there is none.
const loading = '<li class="empty">Loading…</li>'
const BOARDS = [
  { id: "tokens", label: "People" },
  { id: "models", label: "Models" },
  { id: "providers", label: "Providers" },
] as const
---

<div id="board" data-endpoint={endpoint}>
  <div class="switch" role="tablist" aria-label="Board">
    {
      BOARDS.map((board, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          data-board={board.id}
        >
          {board.label}
        </button>
      ))
    }
  </div>

  <section class="panel" id="panel-week">
    <section class="board" data-board="tokens">
      <h2>Top tokens spent</h2>
      <ul class="legend" aria-label="Models" data-list="legend" set:html={endpoint ? "" : tokensLegend(sample)} />
      <ol class="rows" data-list="tokens" set:html={endpoint ? loading : tokensList(sample, { live: false })} />
    </section>

    <section class="board" data-board="models" hidden>
      <h2>Top models</h2>
      <ul class="legend" aria-label="Modes">
        {MODES.map((mode) => <li><span class={`dot mode-${mode.key}`} />{mode.label}</li>)}
      </ul>
      <ol class="rows" data-list="models" set:html={endpoint ? loading : modelsList(sample, { live: false })} />
    </section>

    <section class="board" data-board="providers" hidden>
      <h2>Top providers</h2>
      <ol class="rows" data-list="providers" set:html={endpoint ? loading : providersList(sample, { live: false })} />
    </section>
  </section>
</div>

<script>
  import { readBoard, sampleBoard } from "../lib/board"
  import { modelsList, providersList, tokensLegend, tokensList } from "../lib/render"

  // The board last picked on this device, so a return visit opens where the person left off.
  const STORED_BOARD = "gots-community-board"
  const root = document.getElementById("board")!
  const badge = document.getElementById("sample-badge")
  const switches = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
  const boards = Array.from(root.querySelectorAll<HTMLElement>(".board"))

  function remember(value: string) {
    try {
      localStorage.setItem(STORED_BOARD, value)
    } catch {
      // Storage blocked: the page still works, it just won't remember.
    }
  }

  function stored() {
    try {
      return localStorage.getItem(STORED_BOARD)
    } catch {
      return null
    }
  }

  // One board at a time, so each one has the page to itself and the switch sets them apart.
  function pick(board: string, focus = false) {
    for (const button of switches) {
      const on = button.dataset.board === board
      button.setAttribute("aria-selected", String(on))
      button.tabIndex = on ? 0 : -1
      if (on && focus) button.focus()
    }
    for (const section of boards) section.hidden = section.dataset.board !== board
  }

  for (const button of switches) {
    button.addEventListener("click", () => {
      pick(button.dataset.board!)
      remember(button.dataset.board!)
    })
    button.addEventListener("keydown", (event) => {
      const index = switches.indexOf(button)
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (!step) return
      event.preventDefault()
      const next = switches[(index + step + switches.length) % switches.length]!
      pick(next.dataset.board!, true)
      remember(next.dataset.board!)
    })
  }

  const known = (board: string | null) => switches.some((b) => b.dataset.board === board)
  const saved = stored()
  pick(known(saved) ? saved! : switches[0]!.dataset.board!)

  function show(board: ReturnType<typeof sampleBoard>, live: boolean) {
    const period = board.periods.week
    const panel = document.getElementById("panel-week")!
    panel.querySelector('[data-list="legend"]')!.innerHTML = tokensLegend(period)
    panel.querySelector('[data-list="tokens"]')!.innerHTML = tokensList(period, { live })
    panel.querySelector('[data-list="models"]')!.innerHTML = modelsList(period, { live })
    panel.querySelector('[data-list="providers"]')!.innerHTML = providersList(period, { live })
    badge?.toggleAttribute("hidden", live)
  }

  // Only a board that can't be read falls back to the sample, and then says so.
  const endpoint = root.dataset.endpoint
  if (!endpoint) {
    show(sampleBoard(), false)
  } else {
    fetch(endpoint)
      .then((response) => (response.ok ? response.json() : null))
      .then((value) => {
        const board = readBoard(value)
        if (board) {
          show(board, true)
          document.dispatchEvent(new CustomEvent("board:live", { detail: board.updatedAt }))
        } else {
          show(sampleBoard(), false)
        }
      })
      .catch(() => show(sampleBoard(), false))
  }
</script>
