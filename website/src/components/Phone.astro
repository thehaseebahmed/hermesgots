---
interface Props {
  shot: string
  alt?: string
  eager?: boolean
  dark?: boolean
}

const { shot, alt = "", eager = false, dark = false } = Astro.props
---

<picture class="shot">
  {!dark && <source media="(prefers-color-scheme: dark)" srcset={`/shots/${shot}-dark.webp`} />}
  <img
    src={`/shots/${shot}-${dark ? "dark" : "light"}.webp`}
    alt={alt}
    width="780"
    height="1688"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</picture>
